        "deployment group list --resource-group rg-demo": {"exit_code": 0, "stdout": [{"name": "demo-1761700001", "properties": {"provisioningState": "Failed", "timestamp": "2026-10-28T12:00:00Z"}}]},
        "deployment operation group list --resource-group rg-demo --name demo-1761700001": {"exit_code": 0, "stdout": [
          {"properties": {"provisioningState": "Failed", "targetResource": {"resourceType": "Microsoft.Search/searchServices", "resourceName": "srch-demo"},
            "statusMessage": {"error": {"code": "MissingSubscriptionRegistration", "message": "The subscription is not registered to use namespace 'Microsoft.Search'."}}}}
        ]},
        "resource list --resource-group rg-demo": {"exit_code": 0, "stdout": [
          {"name": "aif-demo", "type": "Microsoft.CognitiveServices/accounts", "provisioningState": "Succeeded"},
          {"name": "cosmos-demo", "type": "Microsoft.DocumentDB/databaseAccounts", "provisioningState": "Succeeded"}
        ]}
      },
      "expect": {"stage": "deployment", "top": ["documented-missingsubscriptionregistration", "provider-unregistered", "partial-deployment"], "action": "register-provider"}
    },
    {
