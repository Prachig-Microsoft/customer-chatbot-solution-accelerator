{
  "_comment": "Evaluation cases. fixture: name of evals/fixtures/<name>.json (replayed az outputs) or 'offline'. patch/appsettings/remove_settings/set inject a single fault into the SYNTHETIC healthy baseline. 'live-*' fixtures are anonymized recordings of real read-only az calls. expect.top: acceptable top hypothesis ids (null = no confirmed/likely hypothesis should be produced).",
  "cases": [
    {
      "id": "healthy-endpoint-errors-no-guess",
      "issue": "My deployment succeeded, but the endpoint is returning errors",
      "fixture": "synthetic-base", "env_file": "synthetic-env.txt",
      "expect": {"accelerator": "customer-chatbot", "stage": "runtime", "top": [null]}
    },
    {
      "id": "placeholder-images",
      "issue": "I ran azd up successfully but the chat app only shows a default hello world page",
      "fixture": "synthetic-base", "env_file": "synthetic-env.txt",
      "set": {
        "webapp show --resource-group rg-demo --name api-chat-demo::siteConfig.linuxFxVersion": "DOCKER|mcr.microsoft.com/azuredocs/containerapps-helloworld:latest",
        "webapp show --resource-group rg-demo --name app-chat-demo::siteConfig.linuxFxVersion": "DOCKER|mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
      },
      "patch": {"HTTP GET https://api-chat-demo.azurewebsites.net/health": {"exit_code": 404, "stdout": {"status": 404, "body_excerpt": "Not Found", "error": ""}}},
      "expect": {"accelerator": "customer-chatbot", "stage": "startup", "top": "images-not-built", "top_status": "confirmed", "action": "build-push-images"}
    },
    {
      "id": "agents-not-created",
      "issue": "The chatbot UI loads but every chat message returns a 500 error after deployment",
      "fixture": "synthetic-base", "env_file": "synthetic-env.txt",
