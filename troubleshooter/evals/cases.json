      "expect": {"stage": "authentication", "top": "rbac-missing", "action": "assign-app-role", "doc": "role-assignments.bicep"}
    },
    {
      "id": "deployment-failed-insufficient-quota-observed",
      "issue": "azd up failed during provisioning and the deployment shows Failed",
      "fixture": "synthetic-base", "env_file": "synthetic-env.txt",
      "patch": {
        "deployment group list --resource-group rg-demo": {"exit_code": 0, "stdout": [{"name": "demo-1761700000", "properties": {"provisioningState": "Failed", "timestamp": "2026-10-28T11:00:00Z"}}]},
        "deployment operation group list --resource-group rg-demo --name demo-1761700000": {"exit_code": 0, "stdout": [
          {"properties": {"provisioningState": "Failed", "timestamp": "2026-10-28T11:02:00Z", "targetResource": {"resourceType": "Microsoft.CognitiveServices/accounts/deployments", "resourceName": "aif-demo/gpt-5.4-mini"},
            "statusMessage": {"status": "Failed", "error": {"code": "InsufficientQuota", "message": "This operation require 50 new capacity in quota Tokens Per Minute (thousands) - gpt-5.4-mini GlobalStandard, which is bigger than the current available capacity 10."}}}}
        ]},
        "cognitiveservices usage list --location *": {"exit_code": 0, "stdout": [
          {"name": {"value": "OpenAI.GlobalStandard.gpt-5.4-mini"}, "currentValue": 990.0, "limit": 1000.0, "scopeType": "Global"},
          {"name": {"value": "OpenAI.GlobalStandard.text-embedding-3-small"}, "currentValue": 0.0, "limit": 3000.0, "scopeType": "Global"},
          {"name": {"value": "OpenAI.GlobalStandard.gpt-realtime-mini"}, "currentValue": 0.0, "limit": 20.0, "scopeType": "Classic"}
        ]}
      },
      "expect": {"stage": "deployment", "top": "quota-insufficient", "top_status": "confirmed", "doc": "TroubleShootingSteps.md:62", "action": "request-quota-increase"}
    },
    {
      "id": "throttling-429",
